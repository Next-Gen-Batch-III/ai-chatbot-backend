generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum MessageType {
  USER_INPUT
  MODEL_OUTPUT
}

enum FileStatus {
  PENDING
  PROCESSING
  FAILED
  EMBEDED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  clerkId   String   @id @map("clerk_id")
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  chats     Chat[]
  projects  Project[]

  @@map("users")
}

model AllowedUser {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index(email)
  @@map("allowed_user")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id")
  title       String    @default("New Project")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  user        User      @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  chats       Chat[]

  @@map("projects")
}

model Chat {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id")
  projectId     String?  @map("project_id") @db.Uuid
  title         String   @default("New Chat")
  isPinned      Boolean  @default(false) @map("is_pinned")
  createdAt     DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  user          User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([userId, isPinned, lastMessageAt(sort: Desc)])
  @@map("chats")
}

model Message {
  id            String   @id @default(uuid()) @db.Uuid
  chatId        String   @map("chat_id") @db.Uuid
  type          MessageType
  content       String   @db.Text
  interactionId String?  @map("interaction_id")
  createdAt     DateTime @default(now()) @map("created_at")

  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt(sort: Desc)])
  @@map("messages")
}

model SystemPrompt {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_prompts")
}

model File {
  id          Int            @id @default(autoincrement())
  title       String
  fileUrl     String         @map("file_url")
  fileType    String         @map("file_type")
  fileSize    Int            @map("file_size")
  status      FileStatus     @default(PENDING)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  failReason  String?        @db.Text @map("fail_reason")

  chunks      FileChunk[]

  @@map("documents")
}

model FileChunk {
  id          String                 @id @default(uuid())
  fileId      Int                    @map("file_id")
  content     String                 @db.Text
  
  embedding   Unsupported("vector(768)")?

  file        File                   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_chunks")
}